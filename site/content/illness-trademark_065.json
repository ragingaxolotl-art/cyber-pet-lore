{"id": "illness-trademark_065", "blocks": [{"id": "illness-trademark_065-title", "text": "Stormstatic Fever", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_065.gif", "still": "illnesses/previews/review-2026-11-22-followup/trademark_065-still.png"}}, {"id": "illness-trademark_065-status", "text": "infection · Location trademark", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_065-definition", "text": "Boundary lightning leaves a persistent hot static pattern.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_065-location", "text": "Location: The Stormwall Orchard", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_065-appearance-reviewed-2026-11-22-followup", "text": "Appearance: Bold electrical veins run from the torso toward the antenna and limbs. A bright charge travels along them, gathers at their ends, then releases branching sparks with a small local twitch. The pet stays visible throughout.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_065-care", "text": "Care: Use the infection treatment listed in Care; cleaning supports recovery.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_065-story", "text": "Story connection: Orchard crews could trace a recurring pulse to a failing storm marker.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_065-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: Proposed.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_065-visual-kind", "text": "Visual type: Effect", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_065-severity", "text": "Mild / moderate / severe: 1 / 2 / 3 body paths carry charge, with discharges every 6 / 4 / 3 seconds.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_065-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_065-1.png", "still": "illnesses/previews/review-2026-11-22-followup/trademark_065-1.png"}}, {"id": "illness-trademark_065-stage-moderate", "text": "Moderate — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_065-2.png", "still": "illnesses/previews/review-2026-11-22-followup/trademark_065-2.png"}}, {"id": "illness-trademark_065-stage-severe", "text": "Severe — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_065-3.png", "still": "illnesses/previews/review-2026-11-22-followup/trademark_065-3.png"}}, {"id": "illness-trademark_065-earlier-versions", "text": "Earlier versions", "style": "HEADING_2"}, {"id": "illness-trademark_065-history-published-before-20261122-title", "text": "Earlier published example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/trademark_065.gif", "still": "illnesses/previews/trademark_065-still.png"}}, {"id": "illness-trademark_065-appearance", "text": "Appearance: Electrical veins carry traveling pulses across the body. Three body-anchored hot spots release short local sparks.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_065-history-published-before-20261122-sheet", "text": "Download the earlier frame sheet", "style": "NORMAL_TEXT", "referenceUrl": "illnesses/previews/trademark_065.png"}], "outline": [{"id": "illness-trademark_065-title", "title": "Stormstatic Fever", "level": 2}, {"id": "illness-trademark_065-earlier-versions", "title": "Earlier versions", "level": 2}]}