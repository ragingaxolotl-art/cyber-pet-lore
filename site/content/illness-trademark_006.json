{"id": "illness-trademark_006", "blocks": [{"id": "illness-trademark_006-title", "text": "Orison Dissonance", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_006.gif", "still": "illnesses/previews/review-2026-11-22/trademark_006-still.png"}}, {"id": "illness-trademark_006-status", "text": "stress · Location trademark", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_006-definition", "text": "Overlapping civic voices fall out of time around the pet.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_006-location", "text": "Location: The Commons and the Orison Chamber", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_006-appearance-reviewed-2026-11-22", "text": "Appearance: The upper quarter of the visible main body waves strongly left and right, including narrow antennae above it. The deformation tapers to exactly zero at the quarter line; the lower three quarters remain unchanged.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_006-care", "text": "Care: Use calm care, rest and the stress treatment listed in Care.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_006-story", "text": "Story connection: A future gathering could reconcile competing versions of a shared promise.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_006-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: The Commons is established canon. The multi-Shelter chamber is story-established in All the Names Between.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_006-visual-kind", "text": "Visual type: Effect", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_006-severity", "text": "Higher severity increases the upper-quarter wave amplitude; the lower three quarters remain unchanged.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_006-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_006-1.png", "still": "illnesses/previews/review-2026-11-22/trademark_006-1.png"}}, {"id": "illness-trademark_006-stage-moderate", "text": "Moderate — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_006-2.png", "still": "illnesses/previews/review-2026-11-22/trademark_006-2.png"}}, {"id": "illness-trademark_006-stage-severe", "text": "Severe — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_006-3.png", "still": "illnesses/previews/review-2026-11-22/trademark_006-3.png"}}, {"id": "illness-trademark_006-earlier-versions", "text": "Earlier versions", "style": "HEADING_2"}, {"id": "illness-trademark_006-history-published-before-20261122-title", "text": "Earlier published example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/trademark_006.gif", "still": "illnesses/previews/trademark_006-still.png"}}, {"id": "illness-trademark_006-appearance", "text": "Appearance: Three civic voice traces cross a shared staff in independent, conflicting rhythms.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_006-history-published-before-20261122-sheet", "text": "Download the earlier frame sheet", "style": "NORMAL_TEXT", "referenceUrl": "illnesses/previews/trademark_006.png"}], "outline": [{"id": "illness-trademark_006-title", "title": "Orison Dissonance", "level": 2}, {"id": "illness-trademark_006-earlier-versions", "title": "Earlier versions", "level": 2}]}