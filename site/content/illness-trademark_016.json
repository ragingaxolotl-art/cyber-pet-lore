{"id": "illness-trademark_016", "blocks": [{"id": "illness-trademark_016-title", "text": "Many-Forms Snare", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_016.gif", "still": "illnesses/previews/review-2026-11-22/trademark_016-still.png"}}, {"id": "illness-trademark_016-status", "text": "injury · Location trademark", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_016-definition", "text": "Misaligned district seams catch a passing pet at their joins.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_016-location", "text": "Location: The Last City of Many Forms", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_016-appearance-reviewed-2026-11-22", "text": "Appearance: The whole character uses a consistent one-to-one RGB palette remap: (R,G,B) becomes (1-G,B,1-R). Identical source colors always receive identical replacements; black becomes magenta. Shape and transparency remain unchanged.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_016-care", "text": "Care: Use injury supplies and the recovery time shown in Care.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_016-story", "text": "Story connection: A civic repair route could reconnect two districts without erasing either.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_016-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: Established Era Three location, possibly several places merged in memory.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_016-visual-kind", "text": "Visual type: Effect", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_016-severity", "text": "All stages share the same stable color mapping; the effect is intentionally static.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_016-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_016-1.png", "still": "illnesses/previews/review-2026-11-22/trademark_016-1.png"}}, {"id": "illness-trademark_016-stage-moderate", "text": "Moderate — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_016-2.png", "still": "illnesses/previews/review-2026-11-22/trademark_016-2.png"}}, {"id": "illness-trademark_016-stage-severe", "text": "Severe — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_016-3.png", "still": "illnesses/previews/review-2026-11-22/trademark_016-3.png"}}, {"id": "illness-trademark_016-earlier-versions", "text": "Earlier versions", "style": "HEADING_2"}, {"id": "illness-trademark_016-history-published-before-20261122-title", "text": "Earlier published example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/trademark_016.gif", "still": "illnesses/previews/trademark_016-still.png"}}, {"id": "illness-trademark_016-appearance", "text": "Appearance: Different district polygons interlock at mismatched contacts, stretching against one another near the lower body.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_016-history-published-before-20261122-sheet", "text": "Download the earlier frame sheet", "style": "NORMAL_TEXT", "referenceUrl": "illnesses/previews/trademark_016.png"}], "outline": [{"id": "illness-trademark_016-title", "title": "Many-Forms Snare", "level": 2}, {"id": "illness-trademark_016-earlier-versions", "title": "Earlier versions", "level": 2}]}