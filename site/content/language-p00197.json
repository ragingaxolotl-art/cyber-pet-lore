{"id": "language-p00197", "blocks": [{"id": "language-p00197", "text": "10. Timing and Relationship Syntax", "style": "HEADING_1", "sourceParagraph": 197}, {"id": "language-p00198", "text": "no gap: modifier relationship", "style": "NORMAL_TEXT", "sourceParagraph": 198}, {"id": "language-p00199", "text": "short gap: argument relationship", "style": "NORMAL_TEXT", "sourceParagraph": 199}, {"id": "language-p00200", "text": "medium gap: next instruction", "style": "NORMAL_TEXT", "sourceParagraph": 200}, {"id": "language-p00201", "text": "long gap: completed statement", "style": "NORMAL_TEXT", "sourceParagraph": 201}, {"id": "language-p00202", "text": "overlap: simultaneous processes", "style": "NORMAL_TEXT", "sourceParagraph": 202}, {"id": "language-p00203", "text": "repeated pulse: recursion or repeated action", "style": "NORMAL_TEXT", "sourceParagraph": 203}, {"id": "language-p00204", "text": "Timing is semantic. Sequential phrases are serial; overlapping phrases are simultaneous or parallel. A repeated pulse can express repetition, habit, recursion, or iteration depending on the semantic domains involved.", "style": "NORMAL_TEXT", "sourceParagraph": 204}], "outline": [{"id": "language-p00197", "title": "10. Timing and Relationship Syntax", "level": 1}]}