{"id": "illness-trademark_021", "blocks": [{"id": "illness-trademark_021-title", "text": "Sixfold Churn", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_021.gif", "still": "illnesses/previews/review-2026-11-22/trademark_021-still.png"}}, {"id": "illness-trademark_021-status", "text": "digestive · Location trademark", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_021-definition", "text": "Six borrowed environmental rhythms arrive in the wrong order and unsettle digestion.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_021-location", "text": "Location: The Folded Garden of Six Traditions", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_021-appearance-reviewed-2026-11-22", "text": "Appearance: Two, four or six extra body parts are sampled from the current character and attached around its outline as severity rises. Extra faces, arms and feet overlap the living body, with a slow connected flex, forming a merged creature.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_021-care", "text": "Care: Use the digestive treatment listed in Care and sensible portions.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_021-story", "text": "Story connection: A garden steward could ask visitors to restore the order of the six traditions.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_021-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: Proposed Era Two–Three location derived from the World Bloom traditions and the Folding of Worlds.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_021-visual-kind", "text": "Visual type: Effect", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_021-severity", "text": "Mild / moderate / severe: 2 / 4 / 6 attached body pieces.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_021-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_021-1.png", "still": "illnesses/previews/review-2026-11-22/trademark_021-1.png"}}, {"id": "illness-trademark_021-stage-moderate", "text": "Moderate — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_021-2.png", "still": "illnesses/previews/review-2026-11-22/trademark_021-2.png"}}, {"id": "illness-trademark_021-stage-severe", "text": "Severe — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_021-3.png", "still": "illnesses/previews/review-2026-11-22/trademark_021-3.png"}}, {"id": "illness-trademark_021-earlier-versions", "text": "Earlier versions", "style": "HEADING_2"}, {"id": "illness-trademark_021-history-published-before-20261122-title", "text": "Earlier published example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/trademark_021.gif", "still": "illnesses/previews/trademark_021-still.png"}}, {"id": "illness-trademark_021-appearance", "text": "Appearance: Six stationary chambers contract in a deliberately broken sequence instead of orbiting the pet.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_021-history-published-before-20261122-sheet", "text": "Download the earlier frame sheet", "style": "NORMAL_TEXT", "referenceUrl": "illnesses/previews/trademark_021.png"}], "outline": [{"id": "illness-trademark_021-title", "title": "Sixfold Churn", "level": 2}, {"id": "illness-trademark_021-earlier-versions", "title": "Earlier versions", "level": 2}]}