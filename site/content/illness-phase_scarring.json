{"id": "illness-phase_scarring", "blocks": [{"id": "illness-phase_scarring-title", "text": "Phase Scarring", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/phase_scarring.gif", "still": "illnesses/previews/review-2026-11-22/phase_scarring-still.png"}}, {"id": "illness-phase_scarring-status", "text": "chronic · Random variant", "style": "NORMAL_TEXT"}, {"id": "illness-phase_scarring-definition", "text": "A randomly selected chronic condition. It uses the category’s existing penalties and treatment.", "style": "NORMAL_TEXT"}, {"id": "illness-phase_scarring-location", "text": "Location: Any location with this category", "style": "NORMAL_TEXT"}, {"id": "illness-phase_scarring-appearance-reviewed-2026-11-22", "text": "Appearance: Three staggered afterimages break into irregular triangular shards of the actual pet texture. The separated pieces burst outward in varied directions, turn independently and fade, like jagged broken glass.", "style": "NORMAL_TEXT"}, {"id": "illness-phase_scarring-care", "text": "Care: Use targeted chronic treatment listed in Care; rest alone does not cure it.", "style": "NORMAL_TEXT"}, {"id": "illness-phase_scarring-story", "text": "Story connection: No fixed location storyline; ordinary cases may appear wherever the category roll succeeds.", "style": "NORMAL_TEXT"}, {"id": "illness-phase_scarring-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: ordinary condition", "style": "NORMAL_TEXT"}, {"id": "illness-phase_scarring-visual-kind", "text": "Visual type: Effect", "style": "NORMAL_TEXT"}, {"id": "illness-phase_scarring-severity", "text": "Mild / moderate / severe: fragment waves repeat every 3.6 / 2.2 / 1.2 seconds.", "style": "NORMAL_TEXT"}, {"id": "illness-phase_scarring-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/phase_scarring-1.png", "still": "illnesses/previews/review-20