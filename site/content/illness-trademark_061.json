{"id": "illness-trademark_061", "blocks": [{"id": "illness-trademark_061-title", "text": "Skyseam Shear", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_061.gif", "still": "illnesses/previews/review-2026-11-22/trademark_061-still.png"}}, {"id": "illness-trademark_061-status", "text": "injury · Location trademark", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_061-definition", "text": "A passing boundary seam briefly pulls adjacent surfaces in different directions.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_061-location", "text": "Location: The Skyfold Boundary", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_061-appearance-reviewed-2026-11-22", "text": "Appearance: A jagged seam splits the actual character image. Its upper and lower sections slide in opposite directions, expose a clear gap, hold, and reconnect over six seconds. Severity widens the separation.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_061-care", "text": "Care: Use injury supplies and the recovery time shown in Care.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_061-story", "text": "Story connection: Migrating guides could chart the safe moment to cross.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_061-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: Proposed.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_061-visual-kind", "text": "Visual type: Effect", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_061-severity", "text": "Higher severity widens the jagged split and displacement. Sections separate, hold and reconnect over six seconds.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_061-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_061-1.png", "still": "illnesses/previews/review-2026-11-22/trademark_061-1.png"}}, {"id": "illness-trademark_061-stage-moderate", "text": "Moderate — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_061-2.png", "still": "illnesses/previews/review-2026-11-22/trademark_061-2.png"}}, {"id": "illness-trademark_061-stage-severe", "text": "Severe — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_061-3.png", "still": "illnesses/previews/review-2026-11-22/trademark_061-3.png"}}, {"id": "illness-trademark_061-earlier-versions", "text": "Earlier versions", "style": "HEADING_2"}, {"id": "illness-trademark_061-history-published-before-20261122-title", "text": "Earlier published example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/trademark_061.gif", "still": "illnesses/previews/trademark_061-still.png"}}, {"id": "illness-trademark_061-appearance", "text": "Appearance: Two translucent sky strips slide in opposite directions across a visibly torn join.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_061-history-published-before-20261122-sheet", "text": "Download the earlier frame sheet", "style": "NORMAL_TEXT", "referenceUrl": "illnesses/previews/trademark_061.png"}], "outline": [{"id": "illness-trademark_061-title", "title": "Skyseam Shear", "level": 2}, {"id": "illness-trademark_061-earlier-versions", "title": "Earlier versions", "level": 2}]}