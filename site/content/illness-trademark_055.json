{"id": "illness-trademark_055", "blocks": [{"id": "illness-trademark_055-title", "text": "Stepwell Slip", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_055.gif", "still": "illnesses/previews/review-2026-11-22-followup/trademark_055-still.png"}}, {"id": "illness-trademark_055-status", "text": "injury · Location trademark", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_055-definition", "text": "Sudden wet-to-dry changes make a stair’s remembered grip disagree with its surface.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_055-location", "text": "Location: The Monsoon Stepwell City", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_055-appearance-reviewed-2026-11-22-followup", "text": "Appearance: One foot visibly slides across a wet tread while the actual body tilts and squashes, holds its lost footing, then catches itself. A short spray of droplets follows the slipping foot. Facing reverses the entire movement; actual game position and action stay unchanged.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_055-care", "text": "Care: Use injury supplies and the recovery time shown in Care.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_055-story", "text": "Story connection: Reservoir keepers could mark the safe stair sequence before the next monsoon.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_055-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: Proposed.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_055-visual-kind", "text": "Visual type: Effect", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_055-severity", "text": "Mild / moderate / severe: slips repeat every 8 / 6 / 4 seconds, with 8% / 14% / 20% body squash and progressively stronger lean and foot displacement.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_055-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_055-1.png", "still": "illnesses/previews/review-2026-11-22-followup/trademark_055-1.png"}}, {"id": "illness-trademark_055-stage-moderate", "text": "Moderate — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_055-2.png", "still": "illnesses/previews/review-2026-11-22-followup/trademark_055-2.png"}}, {"id": "illness-trademark_055-stage-severe", "text": "Severe — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_055-3.png", "still": "illnesses/previews/review-2026-11-22-followup/trademark_055-3.png"}}, {"id": "illness-trademark_055-earlier-versions", "text": "Earlier versions", "style": "HEADING_2"}, {"id": "illness-trademark_055-history-published-before-20261122-title", "text": "Earlier published example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/trademark_055.gif", "still": "illnesses/previews/trademark_055-still.png"}}, {"id": "illness-trademark_055-appearance", "text": "Appearance: A wet tread slips away from its remembered stair, shedding droplets beneath the feet.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_055-history-published-before-20261122-sheet", "text": "Download the earlier frame sheet", "style": "NORMAL_TEXT", "referenceUrl": "illnesses/previews/trademark_055.png"}], "outline": [{"id": "illness-trademark_055-title", "title": "Stepwell Slip", "level": 2}, {"id": "illness-trademark_055-earlier-versions", "title": "Earlier versions", "level": 2}]}