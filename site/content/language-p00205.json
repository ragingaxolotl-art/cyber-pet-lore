{"id": "language-p00205", "blocks": [{"id": "language-p00205", "text": "11. Writing-System Baseline", "style": "HEADING_1", "sourceParagraph": 205}, {"id": "language-p00206", "text": "The writing system is deterministic in information content but does not yet have an approved final visual glyph sheet.", "style": "NORMAL_TEXT", "sourceParagraph": 206}, {"id": "language-p00207", "text": "Outer frame: harmonic family or semantic domain", "style": "NORMAL_TEXT", "sourceParagraph": 207}, {"id": "language-p00208", "text": "Central path: trit movements", "style": "NORMAL_TEXT", "sourceParagraph": 208}, {"id": "language-p00209", "text": "Vertical position: grammatical role or vocal register", "style": "NORMAL_TEXT", "sourceParagraph": 209}, {"id": "language-p00210", "text": "Line contour: sentence or programming function", "style": "NORMAL_TEXT", "sourceParagraph": 210}, {"id": "language-p00211", "text": "Spacing: timing and argument boundaries", "style": "NORMAL_TEXT", "sourceParagraph": 211}, {"id": "language-p00212", "text": "Parallel paths: simultaneous voices or processes", "style": "NORMAL_TEXT", "sourceParagraph": 212}, {"id": "language-p00213", "text": "Tail: runtime state", "style": "NORMAL_TEXT", "sourceParagraph": 213}, {"id": "language-p00214", "text": "Written trit 0: straight continuation", "style": "NORMAL_TEXT", "sourceParagraph": 214}, {"id": "language-p00215", "text": "Written trit 1: upward angle", "style": "NORMAL_TEXT", "sourceParagraph": 215}, {"id": "language-p00216", "text": "Written trit 2: downward angle", "style": "NORMAL_TEXT", "sourceParagraph": 216}, {"id": "language-p00217", "text": "A future glyph renderer must use the same semantic intermediate representation as the note, carrier, transliteration, and executable outputs. Visual style must not alter meaning.", "style": "NORMAL_TEXT", "sourceParagraph": 217}], "outline": [{"id": "language-p00205", "title": "11. Writing-System Baseline", "level": 1}]}