{"id": "illness-trademark_059", "blocks": [{"id": "illness-trademark_059-title", "text": "Dawnlock", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_059.gif", "still": "illnesses/previews/review-2026-11-22/trademark_059-still.png"}}, {"id": "illness-trademark_059-status", "text": "fatigue · Location trademark", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_059-definition", "text": "Paused dawn keeps the pet’s waking rhythm suspended.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_059-location", "text": "Location: The Ice Cave of Paused Dawn", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_059-appearance-reviewed-2026-11-22", "text": "Appearance: Dawnlight climbs through the actual character, stalls halfway with a warm lower half and cool upper half, then breaks into rising rays. The stalled phase lasts 2, 4 or 7 seconds; complete cycles last 7, 9 or 12 seconds.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_059-care", "text": "Care: Rest and recovery time help; avoid repeatedly exhausting the affected skill.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_059-story", "text": "Story connection: A future light study could find the one reflection still advancing.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_059-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: Proposed.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_059-visual-kind", "text": "Visual type: Effect", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_059-severity", "text": "Mild / moderate / severe: dawn stalls for 2 / 4 / 7 seconds, then breaks into 6 / 8 / 10 rising rays.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_059-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_059-1.png", "still": "illnesses/previews/review-2026-11-22/trademark_059-1.png"}}, {"id": "illness-trademark_059-stage-moderate", "text": "Moderate — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_059-2.png", "still": "illnesses/previews/review-2026-11-22/trademark_059-2.png"}}, {"id": "illness-trademark_059-stage-severe", "text": "Severe — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_059-3.png", "still": "illnesses/previews/review-2026-11-22/trademark_059-3.png"}}, {"id": "illness-trademark_059-earlier-versions", "text": "Earlier versions", "style": "HEADING_2"}, {"id": "illness-trademark_059-history-published-before-20261122-title", "text": "Earlier published example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/trademark_059.gif", "still": "illnesses/previews/trademark_059-still.png"}}, {"id": "illness-trademark_059-appearance", "text": "Appearance: A half sun stays pinned to a fixed horizon while detached rays escape upward.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_059-history-published-before-20261122-sheet", "text": "Download the earlier frame sheet", "style": "NORMAL_TEXT", "referenceUrl": "illnesses/previews/trademark_059.png"}], "outline": [{"id": "illness-trademark_059-title", "title": "Dawnlock", "level": 2}, {"id": "illness-trademark_059-earlier-versions", "title": "Earlier versions", "level": 2}]}