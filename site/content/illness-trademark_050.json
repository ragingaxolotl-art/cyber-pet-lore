{"id": "illness-trademark_050", "blocks": [{"id": "illness-trademark_050-title", "text": "Season-Turn Churn", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_050.gif", "still": "illnesses/previews/review-2026-11-22-followup/trademark_050-still.png"}}, {"id": "illness-trademark_050-status", "text": "digestive · Location trademark", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_050-definition", "text": "Broken seasons impose mismatched growth and rest rhythms on digestion.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_050-location", "text": "Location: The Patchwork Prairie of Broken Seasons", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_050-appearance-reviewed-2026-11-22-followup", "text": "Appearance: Seasons pass through the actual body in the wrong order: sprouts grow from the skin, frost spreads over them, autumn leaves dry and tumble away, and summer husks shed grains. Each transition fades smoothly before the next begins.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_050-care", "text": "Care: Use the digestive treatment listed in Care and sensible portions.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_050-story", "text": "Story connection: A communal harvest could reconnect adjoining seasonal plots.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_050-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: Proposed.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_050-visual-kind", "text": "Visual type: Effect", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_050-severity", "text": "Mild / moderate / severe: the full seasonal cycle lasts 16 / 12 / 10 seconds. Coverage spreads across more of the body, with 3 / 4 / 5 attached stems.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_050-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_050-1.png", "still": "illnesses/previews/review-2026-11-22-followup/trademark_050-1.png"}}, {"id": "illness-trademark_050-stage-moderate", "text": "Moderate — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_050-2.png", "still": "illnesses/previews/review-2026-11-22-followup/trademark_050-2.png"}}, {"id": "illness-trademark_050-stage-severe", "text": "Severe — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_050-3.png", "still": "illnesses/previews/review-2026-11-22-followup/trademark_050-3.png"}}, {"id": "illness-trademark_050-earlier-versions", "text": "Earlier versions", "style": "HEADING_2"}, {"id": "illness-trademark_050-history-published-before-20261122-title", "text": "Earlier published example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/trademark_050.gif", "still": "illnesses/previews/trademark_050-still.png"}}, {"id": "illness-trademark_050-appearance", "text": "Appearance: Sprouts, a tumbling autumn leaf, dry husks and frost appear in the wrong seasonal order. The leaf uses a continuous full-turn rotation.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_050-history-published-before-20261122-sheet", "text": "Download the earlier frame sheet", "style": "NORMAL_TEXT", "referenceUrl": "illnesses/previews/trademark_050.png"}], "outline": [{"id": "illness-trademark_050-title", "title": "Season-Turn Churn", "level": 2}, {"id": "illness-trademark_050-earlier-versions", "title": "Earlier versions", "level": 2}]}