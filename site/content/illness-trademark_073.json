{"id": "illness-trademark_073", "blocks": [{"id": "illness-trademark_073-title", "text": "Gravity Split", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_073.gif", "still": "illnesses/previews/review-2026-11-22/trademark_073-still.png"}}, {"id": "illness-trademark_073-status", "text": "stress · Location trademark", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_073-definition", "text": "Borrowed gravity gives the pet several competing senses of down.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_073-location", "text": "Location: The Room of Borrowed Gravity", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_073-appearance-reviewed-2026-11-22", "text": "Appearance: Four competing gravity directions stretch attached body regions upward, downward and sideways with different timing. The body stays connected, with small arrows marking the pulling directions. Stronger illness increases the stretch; the loop lasts eight seconds.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_073-care", "text": "Care: Use calm care, rest and the stress treatment listed in Care.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_073-story", "text": "Story connection: A future room puzzle could return a borrowed direction to its owner.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_073-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: Proposed; independent of the story archive.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_073-visual-kind", "text": "Visual type: Effect", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_073-severity", "text": "Higher severity strengthens all four competing pulls; the continuous cycle lasts eight seconds.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_073-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_073-1.png", "still": "illnesses/previews/review-2026-11-22/trademark_073-1.png"}}, {"id": "illness-trademark_073-stage-moderate", "text": "Moderate — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_073-2.png", "still": "illnesses/previews/review-2026-11-22/trademark_073-2.png"}}, {"id": "illness-trademark_073-stage-severe", "text": "Severe — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_073-3.png", "still": "illnesses/previews/review-2026-11-22/trademark_073-3.png"}}, {"id": "illness-trademark_073-earlier-versions", "text": "Earlier versions", "style": "HEADING_2"}, {"id": "illness-trademark_073-history-published-before-20261122-title", "text": "Earlier published example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/trademark_073.gif", "still": "illnesses/previews/trademark_073-still.png"}}, {"id": "illness-trademark_073-appearance", "text": "Appearance: Separate grains accelerate toward four competing directions of down and settle against temporary ledges.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_073-history-published-before-20261122-sheet", "text": "Download the earlier frame sheet", "style": "NORMAL_TEXT", "referenceUrl": "illnesses/previews/trademark_073.png"}], "outline": [{"id": "illness-trademark_073-title", "title": "Gravity Split", "level": 2}, {"id": "illness-trademark_073-earlier-versions", "title": "Earlier versions", "level": 2}]}