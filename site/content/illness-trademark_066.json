{"id": "illness-trademark_066", "blocks": [{"id": "illness-trademark_066-title", "text": "Worldscar Abrasion", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_066.gif", "still": "illnesses/previews/review-2026-11-22-followup/trademark_066-still.png"}}, {"id": "illness-trademark_066-status", "text": "injury · Location trademark", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_066-definition", "text": "Historical seams rub against one another and scuff a crossing visitor.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_066-location", "text": "Location: The Mosaic Worldscar", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_066-appearance-reviewed-2026-11-22-followup", "text": "Appearance: Irregular patches of sand, moss and stone appear embedded in the actual body. Their ragged rims scrape and shed tiny rotating grains while a moving boundary exposes a different terrain layer underneath. The patches remain clipped to the character silhouette.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_066-care", "text": "Care: Use injury supplies and the recovery time shown in Care.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_066-story", "text": "Story connection: A repair story could preserve the mosaic’s histories while making a safe path.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_066-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: Proposed.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_066-visual-kind", "text": "Visual type: Effect", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_066-severity", "text": "Mild / moderate / severe: 2 / 3 / 4 larger terrain patches spread across the body. Their layers change in a continuous 12-second cycle; grains shed at staggered intervals.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_066-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_066-1.png", "still": "illnesses/previews/review-2026-11-22-followup/trademark_066-1.png"}}, {"id": "illness-trademark_066-stage-moderate", "text": "Moderate — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_066-2.png", "still": "illnesses/previews/review-2026-11-22-followup/trademark_066-2.png"}}, {"id": "illness-trademark_066-stage-severe", "text": "Severe — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_066-3.png", "still": "illnesses/previews/review-2026-11-22-followup/trademark_066-3.png"}}, {"id": "illness-trademark_066-earlier-versions", "text": "Earlier versions", "style": "HEADING_2"}, {"id": "illness-trademark_066-history-published-before-20261122-title", "text": "Earlier published example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/trademark_066.gif", "still": "illnesses/previews/trademark_066-still.png"}}, {"id": "illness-trademark_066-appearance", "text": "Appearance: Historical mosaic seams and tiny changing scuffs form a translucent abrasion clipped to the body.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_066-history-published-before-20261122-sheet", "text": "Download the earlier frame sheet", "style": "NORMAL_TEXT", "referenceUrl": "illnesses/previews/trademark_066.png"}], "outline": [{"id": "illness-trademark_066-title", "title": "Worldscar Abrasion", "level": 2}, {"id": "illness-trademark_066-earlier-versions", "title": "Earlier versions", "level": 2}]}