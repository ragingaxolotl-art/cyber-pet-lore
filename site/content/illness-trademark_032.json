{"id": "illness-trademark_032", "blocks": [{"id": "illness-trademark_032-title", "text": "Doorwake Drift", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_032.gif", "still": "illnesses/previews/review-2026-11-22/trademark_032-still.png"}}, {"id": "illness-trademark_032-status", "text": "stress · Location trademark", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_032-definition", "text": "Competing shore doors pull the pet’s outline toward incompatible destinations.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_032-location", "text": "Location: The Inland Sea of Doors", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_032-appearance-reviewed-2026-11-22", "text": "Appearance: Two linked doors trap the character in a continuous walking loop. As its actual pixels enter one doorway, they emerge from the opposite doorway, with an alternating foot stride and no full-body disappearance. Gameplay position, size and action stay unchanged. Mild, moderate and severe loops last 8, 6 and 4 seconds; reduced motion freezes the crossing.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_032-care", "text": "Care: Use calm care, rest and the stress treatment listed in Care.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_032-story", "text": "Story connection: A future door survey could identify a shore that has not yet been mapped.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_032-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: Proposed.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_032-visual-kind", "text": "Visual type: Effect", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_032-severity", "text": "Mild / moderate / severe: the linked-door walking loop lasts 8 / 6 / 4 seconds. Actual game position stays unchanged.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_032-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_032-1.png", "still": "illnesses/previews/review-2026-11-22/trademark_032-1.png"}}, {"id": "illness-trademark_032-stage-moderate", "text": "Moderate — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_032-2.png", "still": "illnesses/previews/review-2026-11-22/trademark_032-2.png"}}, {"id": "illness-trademark_032-stage-severe", "text": "Severe — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_032-3.png", "still": "illnesses/previews/review-2026-11-22/trademark_032-3.png"}}, {"id": "illness-trademark_032-earlier-versions", "text": "Earlier versions", "style": "HEADING_2"}, {"id": "illness-trademark_032-history-published-before-20261122-title", "text": "Earlier published example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/trademark_032.gif", "still": "illnesses/previews/trademark_032-still.png"}}, {"id": "illness-trademark_032-appearance", "text": "Appearance: Two leaning shore doors pull unresolved threads from the body toward opposing destinations.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_032-history-published-before-20261122-sheet", "text": "Download the earlier frame sheet", "style": "NORMAL_TEXT", "referenceUrl": "illnesses/previews/trademark_032.png"}, {"id": "illness-trademark_032-history-earlier-stretch-title", "text": "Earlier reviewed version — stretching doors", "style": "HEADING_3", "referenceArt": {"src": "illnesses/history/2026-11-22-before/doorwake-stretch.png", "still": "illnesses/history/2026-11-22-before/doorwake-stretch.png"}}, {"id": "illness-trademark_032-history-earlier-stretch-appearance", "text": "Appearance: Two opposing doors stretched the actual pet horizontally, held it under tension, then let it recover. This was replaced by the linked-door walking loop.", "style": "NORMAL_TEXT"}], "outline": [{"id": "illness-trademark_032-title", "title": "Doorwake Drift", "level": 2}, {"id": "illness-trademark_032-earlier-versions", "title": "Earlier versions", "level": 2}]}