{"id": "illness-trademark_001", "blocks": [{"id": "illness-trademark_001-title", "text": "Reply Echo", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_001.gif", "still": "illnesses/previews/review-2026-11-22/trademark_001-still.png"}}, {"id": "illness-trademark_001-status", "text": "stress · Location trademark", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_001-definition", "text": "Deleted replies recur in the pet’s signal, mirroring the board’s reconstructed messages.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_001-location", "text": "Location: Cacheboard, the Unintended Board", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_001-appearance-reviewed-2026-11-22", "text": "Appearance: Afterimages keep floating outward. Periodically the main pet disappears while six copies scatter for 0.85 seconds, return in 0.18 seconds, and merge back. Events recur every 10, 6, or 3.8 seconds by severity; reduced motion never hides the pet.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_001-care", "text": "Care: Use calm care, rest and the stress treatment listed in Care.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_001-story", "text": "Story connection: A reply fragment could lead to a contributor whose record was erased.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_001-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: Established Era −3 location. Production details are an expanded reconstruction.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_001-visual-kind", "text": "Visual type: Effect", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_001-severity", "text": "Mild / moderate / severe: scatter-and-return events recur every 10 / 6 / 3.8 seconds. Return is faster than departure.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_001-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_001-1.png", "still": "illnesses/previews/review-2026-11-22/trademark_001-1.png"}}, {"id": "illness-trademark_001-stage-moderate", "text": "Moderate — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_001-2.png", "still": "illnesses/previews/review-2026-11-22/trademark_001-2.png"}}, {"id": "illness-trademark_001-stage-severe", "text": "Severe — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_001-3.png", "still": "illnesses/previews/review-2026-11-22/trademark_001-3.png"}}, {"id": "illness-trademark_001-earlier-versions", "text": "Earlier versions", "style": "HEADING_2"}, {"id": "illness-trademark_001-history-published-before-20261122-title", "text": "Earlier published example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/trademark_001.gif", "still": "illnesses/previews/trademark_001-still.png"}}, {"id": "illness-trademark_001-appearance", "text": "Appearance: Broken reply fragments leave, wait, and return with missing text strokes before fading.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_001-history-published-before-20261122-sheet", "text": "Download the earlier frame sheet", "style": "NORMAL_TEXT", "referenceUrl": "illnesses/previews/trademark_001.png"}], "outline": [{"id": "illness-trademark_001-title", "title": "Reply Echo", "level": 2}, {"id": "illness-trademark_001-earlier-versions", "title": "Earlier versions", "level": 2}]}