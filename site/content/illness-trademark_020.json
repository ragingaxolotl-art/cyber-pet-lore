{"id": "illness-trademark_020", "blocks": [{"id": "illness-trademark_020-title", "text": "Return-Signal Fever", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_020.gif", "still": "illnesses/previews/review-2026-11-22/trademark_020-still.png"}}, {"id": "illness-trademark_020-status", "text": "infection · Location trademark", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_020-definition", "text": "Repeated transit signals build a hot, unstable rhythm in the pet’s signal.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_020-location", "text": "Location: The Underway of Returning Signals", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_020-appearance-reviewed-2026-11-22", "text": "Appearance: Bright pulses leave the torso and return; each impact sends an orange heat ripple through the actual body. Mild, moderate and severe emit 1, 2 and 3 staggered pulses per six-second cycle.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_020-care", "text": "Care: Use the infection treatment listed in Care; cleaning supports recovery.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_020-story", "text": "Story connection: Following the repeated call could locate a stranded relay.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_020-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: Proposed Era Three transit location, derived from dormant transit corridors becoming dangerous underways and from Corridor/Relay history.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_020-visual-kind", "text": "Visual type: Effect", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_020-severity", "text": "Mild / moderate / severe: 1 / 2 / 3 staggered returning pulses per six-second cycle.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_020-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_020-1.png", "still": "illnesses/previews/review-2026-11-22/trademark_020-1.png"}}, {"id": "illness-trademark_020-stage-moderate", "text": "Moderate — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_020-2.png", "still": "illnesses/previews/review-2026-11-22/trademark_020-2.png"}}, {"id": "illness-trademark_020-stage-severe", "text": "Severe — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_020-3.png", "still": "illnesses/previews/review-2026-11-22/trademark_020-3.png"}}, {"id": "illness-trademark_020-earlier-versions", "text": "Earlier versions", "style": "HEADING_2"}, {"id": "illness-trademark_020-history-published-before-20261122-title", "text": "Earlier published example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/trademark_020.gif", "still": "illnesses/previews/trademark_020-still.png"}}, {"id": "illness-trademark_020-appearance", "text": "Appearance: Relay calls climb a small signal mast and return as hotter downward pulses.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_020-history-published-before-20261122-sheet", "text": "Download the earlier frame sheet", "style": "NORMAL_TEXT", "referenceUrl": "illnesses/previews/trademark_020.png"}], "outline": [{"id": "illness-trademark_020-title", "title": "Return-Signal Fever", "level": 2}, {"id": "illness-trademark_020-earlier-versions", "title": "Earlier versions", "level": 2}]}