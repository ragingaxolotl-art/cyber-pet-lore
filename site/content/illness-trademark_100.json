{"id": "illness-trademark_100", "blocks": [{"id": "illness-trademark_100-title", "text": "Beacon Recursion", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_100.gif", "still": "illnesses/previews/review-2026-11-22/trademark_100-still.png"}}, {"id": "illness-trademark_100-status", "text": "stress · Location trademark", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_100-definition", "text": "The lighthouse repeats the pet’s signal at receding angles.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_100-location", "text": "Location: The Recursive Lighthouse", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_100-appearance-reviewed-2026-11-22", "text": "Appearance: A beam emitted from the body reveals a smaller copy of the current pet, whose beam reveals another smaller copy. Mild, moderate and severe create 2, 3 and 4 successive copies. The sequence builds, holds and fades over six seconds.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_100-care", "text": "Care: Use calm care, rest and the stress treatment listed in Care.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_100-story", "text": "Story connection: A future signal puzzle could distinguish a real distress call from its copies.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_100-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: Proposed; independent of the story archive.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_100-visual-kind", "text": "Visual type: Effect", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_100-severity", "text": "Mild / moderate / severe: 2 / 3 / 4 progressively smaller copies, each emitting the next beam.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_100-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_100-1.png", "still": "illnesses/previews/review-2026-11-22/trademark_100-1.png"}}, {"id": "illness-trademark_100-stage-moderate", "text": "Moderate — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_100-2.png", "still": "illnesses/previews/review-2026-11-22/trademark_100-2.png"}}, {"id": "illness-trademark_100-stage-severe", "text": "Severe — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_100-3.png", "still": "illnesses/previews/review-2026-11-22/trademark_100-3.png"}}, {"id": "illness-trademark_100-earlier-versions", "text": "Earlier versions", "style": "HEADING_2"}, {"id": "illness-trademark_100-history-published-before-20261122-title", "text": "Earlier published example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/trademark_100.gif", "still": "illnesses/previews/trademark_100-still.png"}}, {"id": "illness-trademark_100-appearance", "text": "Appearance: Four receding lighthouse wedges repeat the signal at offset angles. Their rotation is continuous and completes full turns without snapping back.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_100-history-published-before-20261122-sheet", "text": "Download the earlier frame sheet", "style": "NORMAL_TEXT", "referenceUrl": "illnesses/previews/trademark_100.png"}], "outline": [{"id": "illness-trademark_100-title", "title": "Beacon Recursion", "level": 2}, {"id": "illness-trademark_100-earlier-versions", "title": "Earlier versions", "level": 2}]}