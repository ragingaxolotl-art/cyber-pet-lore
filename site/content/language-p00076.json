{"id": "language-p00076", "blocks": [{"id": "language-p00076", "text": "4. Atomic Address Cube", "style": "HEADING_1", "sourceParagraph": 76}, {"id": "language-p00077", "text": "Normal atomic address length: 3 trits", "style": "NORMAL_TEXT", "sourceParagraph": 77}, {"id": "language-p00078", "text": "Positions per family: 27", "style": "NORMAL_TEXT", "sourceParagraph": 78}, {"id": "language-p00079", "text": "Total atomic inventory: 12 × 27 = 324 roots", "style": "NORMAL_TEXT", "sourceParagraph": 79}, {"id": "language-p00080", "text": "Each trit position answers a different semantic question.", "style": "NORMAL_TEXT", "sourceParagraph": 80}, {"id": "language-p00081", "text": "First trit — concept type", "style": "HEADING_2", "sourceParagraph": 81}, {"id": "language-p00082", "text": "0: entity, substance, or condition", "style": "NORMAL_TEXT", "sourceParagraph": 82}, {"id": "language-p00083", "text": "1: process, action, or transformation", "style": "NORMAL_TEXT", "sourceParagraph": 83}, {"id": "language-p00084", "text": "2: relationship, capacity, or possibility", "style": "NORMAL_TEXT", "sourceParagraph": 84}, {"id": "language-p00085", "text": "Second trit — direction", "style": "HEADING_2", "sourceParagraph": 85}, {"id": "language-p00086", "text": "0: inward, self, or source", "style": "NORMAL_TEXT", "sourceParagraph": 86}, {"id": "language-p00087", "text": "1: outward, other, or target", "style": "NORMAL_TEXT", "sourceParagraph": 87}, {"id": "language-p00088", "text": "2: shared, environmental, distributed, or systemic", "style": "NORMAL_TEXT", "sourceParagraph": 88}, {"id": "language-p00089", "text": "Third trit — conceptual expression", "style": "HEADING_2", "sourceParagraph": 89}, {"id": "language-p00090", "text": "0: stable, bounded, or completed", "style": "NORMAL_TEXT", "sourceParagraph": 90}, {"id": "language-p00091", "text": "1: active, changing, or expressed", "style": "NORMAL_TEXT", "sourceParagraph": 91}, {"id": "language-p00092", "text": "2: dormant, unresolved, or potential", "style": "NORMAL_TEXT", "sourceParagraph": 92}, {"id": "language-p00093", "text": "The third address trit is part of the root’s permanent meaning. It is not the same as the separate runtime state appended to an utterance.", "style": "NORMAL_TEXT", "sourceParagraph": 93}, {"id": "language-p00094", "text": "All 27 universal positions", "style": "HEADING_2", "sourceParagraph": 94}, {"id": "language-p00095", "text": "000: stable inward entity", "style": "NORMAL_TEXT", "sourceParagraph": 95}, {"id": "language-p00096", "text": "001: active inward entity", "style": "NORMAL_TEXT", "sourceParagraph": 96}, {"id": "language-p00097", "text": "002: dormant inward entity", "style": "NORMAL_TEXT", "sourceParagraph": 97}, {"id": "language-p00098", "text": "010: stable outward entity", "style": "NORMAL_TEXT", "sourceParagraph": 98}, {"id": "language-p00099", "text": "011: active outward entity", "style": "NORMAL_TEXT", "sourceParagraph": 99}, {"id": "language-p00100", "text": "012: dormant outward entity", "style": "NORMAL_TEXT", "sourceParagraph": 100}, {"id": "language-p00101", "text": "020: stable collective entity", "style": "NORMAL_TEXT", "sourceParagraph": 101}, {"id": "language-p00102", "text": "021: active collective entity", "style": "NORMAL_TEXT", "sourceParagraph": 102}, {"id": "language-p00103", "text": "022: dormant collective entity", "style": "NORMAL_TEXT", "sourceParagraph": 103}, {"id": "language-p00104", "text": "100: completed inward process", "style": "NORMAL_TEXT", "sourceParagraph": 104}, {"id": "language-p00105", "text": "101: active inward process", "style": "NORMAL_TEXT", "sourceParagraph": 105}, {"id": "language-p00106", "text": "102: pending inward process", "style": "NORMAL_TEXT", "sourceParagraph": 106}, {"id": "language-p00107", "text": "110: completed outward process", "style": "NORMAL_TEXT", "sourceParagraph": 107}, {"id": "language-p00108", "text": "111: active outward process", "style": "NORMAL_TEXT", "sourceParagraph": 108}, {"id": "language-p00109", "text": "112: pending outward process", "style": "NORMAL_TEXT", "sourceParagraph": 109}, {"id": "language-p00110", "text": "120: completed systemic process", "style": "NORMAL_TEXT", "sourceParagraph": 110}, {"id": "language-p00111", "text": "121: active systemic process", "style": "NORMAL_TEXT", "sourceParagraph": 111}, {"id": "language-p00112", "text": "122: pending systemic process", "style": "NORMAL_TEXT", "sourceParagraph": 112}, {"id": "language-p00113", "text": "200: stable inward capacity", "style": "NORMAL_TEXT", "sourceParagraph": 113}, {"id": "language-p00114", "text": "201: active inward capacity", "style": "NORMAL_TEXT", "sourceParagraph": 114}, {"id": "language-p00115", "text": "202: dormant inward capacity", "style": "NORMAL_TEXT", "sourceParagraph": 115}, {"id": "language-p00116", "text": "210: stable outward relationship", "style": "NORMAL_TEXT", "sourceParagraph": 116}, {"id": "language-p00117", "text": "211: active outward relationship", "style": "NORMAL_TEXT", "sourceParagraph": 117}, {"id": "language-p00118", "text": "212: unresolved outward relationship", "style": "NORMAL_TEXT", "sourceParagraph": 118}, {"id": "language-p00119", "text": "220: stable systemic relationship", "style": "NORMAL_TEXT", "sourceParagraph": 119}, {"id": "language-p00120", "text": "221: active systemic relationship", "style": "NORMAL_TEXT", "sourceParagraph": 120}, {"id": "language-p00121", "text": "222: unrealized systemic possibility", "style": "NORMAL_TEXT", "sourceParagraph": 121}], "outline": [{"id": "language-p00076", "title": "4. Atomic Address Cube", "level": 1}, {"id": "language-p00081", "title": "First trit — concept type", "level": 2}, {"id": "language-p00085", "title": "Second trit — direction", "level": 2}, {"id": "language-p00089", "title": "Third trit — conceptual expression", "level": 2}, {"id": "language-p00094", "title": "All 27 universal positions", "level": 2}]}