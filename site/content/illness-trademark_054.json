{"id": "illness-trademark_054", "blocks": [{"id": "illness-trademark_054-title", "text": "Borrowed-Moon Languor", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_054.gif", "still": "illnesses/previews/review-2026-11-22/trademark_054-still.png"}}, {"id": "illness-trademark_054-status", "text": "fatigue · Location trademark", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_054-definition", "text": "Several moon rhythms demand rest at different times.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_054-location", "text": "Location: The Orchard of Borrowed Moons", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_054-appearance-reviewed-2026-11-22", "text": "Appearance: Three large crescents tug on different body columns. The head and body droop out of sync while the feet stay anchored, then recover in a continuous eight-second cycle. Higher severity deepens the droop.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_054-care", "text": "Care: Rest and recovery time help; avoid repeatedly exhausting the affected skill.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_054-story", "text": "Story connection: A future moon festival could reveal who first borrowed the orchard’s light.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_054-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: Proposed.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_054-visual-kind", "text": "Visual type: Effect", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_054-severity", "text": "Mild / moderate / severe: maximum body-column droop is 19.5% / 25% / 30.5%; the moons have offset phases in an eight-second loop.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_054-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_054-1.png", "still": "illnesses/previews/review-2026-11-22/trademark_054-1.png"}}, {"id": "illness-trademark_054-stage-moderate", "text": "Moderate — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_054-2.png", "still": "illnesses/previews/review-2026-11-22/trademark_054-2.png"}}, {"id": "illness-trademark_054-stage-severe", "text": "Severe — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_054-3.png", "still": "illnesses/previews/review-2026-11-22/trademark_054-3.png"}}, {"id": "illness-trademark_054-earlier-versions", "text": "Earlier versions", "style": "HEADING_2"}, {"id": "illness-trademark_054-history-published-before-20261122-title", "text": "Earlier published example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/trademark_054.gif", "still": "illnesses/previews/trademark_054-still.png"}}, {"id": "illness-trademark_054-appearance", "text": "Appearance: Three suspended crescents change phase on independent clocks and shed slow sleep-light ticks.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_054-history-published-before-20261122-sheet", "text": "Download the earlier frame sheet", "style": "NORMAL_TEXT", "referenceUrl": "illnesses/previews/trademark_054.png"}], "outline": [{"id": "illness-trademark_054-title", "title": "Borrowed-Moon Languor", "level": 2}, {"id": "illness-trademark_054-earlier-versions", "title": "Earlier versions", "level": 2}]}