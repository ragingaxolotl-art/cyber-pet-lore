{"id": "illness-trademark_096", "blocks": [{"id": "illness-trademark_096-title", "text": "Season Mismatch", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_096.gif", "still": "illnesses/previews/review-2026-11-22-followup/trademark_096-still.png"}}, {"id": "illness-trademark_096-status", "text": "digestive · Location trademark", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_096-definition", "text": "Adjacent rooms disagree about the body’s seasonal rhythm.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_096-location", "text": "Location: The Rooms of Mismatched Seasons", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_096-appearance-reviewed-2026-11-22-followup", "text": "Appearance: Conflicting weather affects different body regions at the same time: branching frost covers one side while the other warms, droops and sheds dry leaves. Translucent steam curls rise along their shared boundary. The cold and hot sides follow the character’s facing.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_096-care", "text": "Care: Use the digestive treatment listed in Care and sensible portions.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_096-story", "text": "Story connection: A future household story could reconcile rooms without forcing a single season.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_096-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: Proposed; independent of the story archive.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_096-visual-kind", "text": "Visual type: Effect", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_096-severity", "text": "Higher severity spreads the conflicting weather over more of the body, deepens the warm-side wilt, and adds more frost marks and steam curls. The shared cycle lasts six seconds.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_096-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_096-1.png", "still": "illnesses/previews/review-2026-11-22-followup/trademark_096-1.png"}}, {"id": "illness-trademark_096-stage-moderate", "text": "Moderate — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_096-2.png", "still": "illnesses/previews/review-2026-11-22-followup/trademark_096-2.png"}}, {"id": "illness-trademark_096-stage-severe", "text": "Severe — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22-followup/trademark_096-3.png", "still": "illnesses/previews/review-2026-11-22-followup/trademark_096-3.png"}}, {"id": "illness-trademark_096-earlier-versions", "text": "Earlier versions", "style": "HEADING_2"}, {"id": "illness-trademark_096-history-published-before-20261122-title", "text": "Earlier published example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/trademark_096.gif", "still": "illnesses/previews/trademark_096-still.png"}}, {"id": "illness-trademark_096-appearance", "text": "Appearance: Adjacent cold and hot room tiles send frost and warm grains in opposing directions across their shared wall.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_096-history-published-before-20261122-sheet", "text": "Download the earlier frame sheet", "style": "NORMAL_TEXT", "referenceUrl": "illnesses/previews/trademark_096.png"}], "outline": [{"id": "illness-trademark_096-title", "title": "Season Mismatch", "level": 2}, {"id": "illness-trademark_096-earlier-versions", "title": "Earlier versions", "level": 2}]}