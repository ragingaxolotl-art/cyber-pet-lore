{"id": "illness-trademark_008", "blocks": [{"id": "illness-trademark_008-title", "text": "Shelter Afterimage", "style": "HEADING_2", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_008.gif", "still": "illnesses/previews/review-2026-11-22/trademark_008-still.png"}}, {"id": "illness-trademark_008-status", "text": "chronic · Location trademark", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_008-definition", "text": "The missing partitions leave the pet’s outline briefly searching for a room that is gone.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_008-location", "text": "Location: Shelter Orison, the Vanishing Shelter", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_008-appearance-reviewed-2026-11-22", "text": "Appearance: Opaque Blue Cap and Meep visitors emerge through a temporary door at the pet, linger nearby, and disappear through a separate exit door. Mild, moderate and severe show up to 1, 3 and 5 visitors, lingering for 4, 8 and 14 seconds. Doorway wipes preserve solid character colors; reduced motion holds the visitors and doors still.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_008-care", "text": "Care: Use targeted chronic treatment listed in Care; rest alone does not cure it.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_008-story", "text": "Story connection: A future rescue could distinguish shelter memories from navigable rooms.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_008-status-note", "text": "New gameplay lore; future hook is hypothetical. Location status remains: Story-established. Its internal geography is only partly recoverable.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_008-visual-kind", "text": "Visual type: Sprite + effect", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_008-severity", "text": "Mild / moderate / severe: up to 1 / 3 / 5 visitors linger for 4 / 8 / 14 seconds.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_008-stage-mild", "text": "Mild — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_008-1.png", "still": "illnesses/previews/review-2026-11-22/trademark_008-1.png"}}, {"id": "illness-trademark_008-stage-moderate", "text": "Moderate — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_008-2.png", "still": "illnesses/previews/review-2026-11-22/trademark_008-2.png"}}, {"id": "illness-trademark_008-stage-severe", "text": "Severe — current example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/review-2026-11-22/trademark_008-3.png", "still": "illnesses/previews/review-2026-11-22/trademark_008-3.png"}}, {"id": "illness-trademark_008-earlier-versions", "text": "Earlier versions", "style": "HEADING_2"}, {"id": "illness-trademark_008-history-published-before-20261122-title", "text": "Earlier published example", "style": "HEADING_3", "referenceArt": {"src": "illnesses/previews/trademark_008.gif", "still": "illnesses/previews/trademark_008-still.png"}}, {"id": "illness-trademark_008-appearance", "text": "Appearance: A remembered shelter outline tries to rebuild its missing room, sliding a doorway partition around the visitor.", "style": "NORMAL_TEXT"}, {"id": "illness-trademark_008-history-published-before-20261122-sheet", "text": "Download the earlier frame sheet", "style": "NORMAL_TEXT", "referenceUrl": "illnesses/previews/trademark_008.png"}], "outline": [{"id": "illness-trademark_008-title", "title": "Shelter Afterimage", "level": 2}, {"id": "illness-trademark_008-earlier-versions", "title": "Earlier versions", "level": 2}]}